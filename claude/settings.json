{
  "env": {},
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Glob",
      "Grep",
      "LS",
      "List",
      "Find",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(npm run test:*)",
      "Bash(yarn:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "WebFetch",
      "WebSearch",
      "Task",
      "Agent"
    ],
    "deny": [
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./node_modules/**)",
      "Read(./build/**)",
      "Edit(./build/**)",
      "Read(./dist/**)",
      "Edit(./dist/**)",
      "Read(./.next/**)",
      "Read(./target/**)",
      "Edit(./production.config.*)",
      "Edit(./prod.config.*)",
      "Edit(./kubernetes/**)",
      "Edit(./terraform/**)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(*deploy*)",
      "Bash(*publish*)"
    ],
    "ask": [],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.js) prettier --write \"$f\" >/dev/null 2>&1 ;; esac; exit 0"
          },
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.ts|*.tsx) [ -x node_modules/.bin/tsc ] || exit 0; out=$(node_modules/.bin/tsc --noEmit --skipLibCheck \"$f\" 2>&1) || { printf '⚠️  TypeScript errors in %s:\\n%s\\n' \"$f\" \"$out\" >&2; exit 2; } ;; esac; exit 0"
          },
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.py) python -m black -q \"$f\" >/dev/null 2>&1; out=$(python -m flake8 \"$f\" 2>/dev/null); [ -n \"$out\" ] && { printf '%s\\n' \"$out\" >&2; exit 2; } ;; esac; exit 0"
          },
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.json) jq empty \"$f\" >/dev/null 2>&1 || { echo \"⚠️  Invalid JSON in $f\" >&2; exit 2; } ;; esac; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"🚀 Claude Code session started in $CLAUDE_PROJECT_DIR\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "database-developer-tools@stat-ai": true,
    "developer-tools@stat-ai": true,
    "embedded-developer-tools@stat-ai": true,
    "project-manager-tools@stat-ai": true,
    "qa-tools@stat-ai": true,
    "shared-tools@stat-ai": true,
    "web-developer-tools@stat-ai": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "stat-ai": {
      "source": {
        "source": "git",
        "url": "git@bitbucket.org:gohcl/stat-ai.git"
      }
    }
  },
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": false,
    "network": {
      "allowUnixSockets": []
    },
    "excludedCommands": []
  },
  "spinnerTipsEnabled": true,
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "awaySummaryEnabled": false,
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "fileCheckpointingEnabled": false,
  "maxTokens": 4096,
  "autoAcceptPermissions": false,
  "projectName": "",
  "defaultBranch": "develop",
  "testCommand": "npm test",
  "lintCommand": "npm run lint",
  "buildCommand": "npm run build",
  "_metadata": {
    "version": "1.0.0",
    "description": "Claude Code settings for [project name]",
    "lastModified": "2025-10-23",
    "author": "Kurt Wolf <kwolf@gohcl.com>"
  }
}
