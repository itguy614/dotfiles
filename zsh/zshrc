#--------------------------------------------------------------------------
# Locate the dotfiles checkout
#--------------------------------------------------------------------------
# %x is this file; :A resolves the ~/.zshrc symlink, :h:h walks zsh/ -> root.
DOTFILES="${${(%):-%x}:A:h:h}"
export DOTFILES

source "$DOTFILES/lib/platform.sh"
source "$DOTFILES/shell/env.sh"

#--------------------------------------------------------------------------
# Tmux auto-attach
#--------------------------------------------------------------------------
# Early on purpose: when this execs into tmux the rc is re-run inside the new
# session, so there is no point configuring the outer shell first.
[[ -f ~/.tmux.zsh ]] && source ~/.tmux.zsh

#--------------------------------------------------------------------------
# Zsh options
#--------------------------------------------------------------------------
HYPHEN_INSENSITIVE="true"
COMPLETION_WAITING_DOTS="true"
HIST_STAMPS="yyyy-mm-dd"
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt AUTO_CD

VI_MODE_SET_CURSOR="true"
VI_MODE_RESET_PROMPT_ON_MODE_CHANGE="true"
export KEYTIMEOUT=15

typeset -U path cdpath fpath

#--------------------------------------------------------------------------
# Oh My Zsh
#--------------------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"

# Starship owns the prompt. Fall back to a bundled theme only where starship
# is not installed, so a fresh box is never left with a bare PS1.
if command -v starship &>/dev/null; then
	ZSH_THEME=""
else
	ZSH_THEME="gallifrey"
fi

plugins=(
    fzf-tab
    colored-man-pages
    colorize
    common-aliases
    composer
    cp
    extract
    git
    gitignore
    npm
    pip
    python
    sudo
    tmux
    vi-mode
    vscode
    web-search
    aws
    zsh-autosuggestions
    zsh-completions
    zsh-history-substring-search
    zsh-syntax-highlighting)

# Plugins that warn loudly when their tool is absent are added only when the
# tool is actually installed.
command -v direnv &>/dev/null && plugins+=(direnv)

# Platform config runs first so it can extend $plugins and fix up $PATH before
# oh-my-zsh loads. It may also define platform_post_omz() for work that has to
# happen after oh-my-zsh (see zsh/zshrc.omarchy).
[[ -f ~/.zshrc.os ]] && source ~/.zshrc.os

# Machine-specific overrides, untracked.
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

[[ -d "$ZSH" ]] && source "$ZSH/oh-my-zsh.sh"

(( $+functions[platform_post_omz] )) && platform_post_omz

#--------------------------------------------------------------------------
# Shared aliases and functions
#--------------------------------------------------------------------------
# After oh-my-zsh and after the platform layer, so these win every collision.
source "$DOTFILES/shell/aliases.sh"
source "$DOTFILES/shell/functions.sh"

#--------------------------------------------------------------------------
# Completions
#--------------------------------------------------------------------------
_gitignoreio() {
	compset -P '*,'
	compadd -S '' $(_gitignoreio_get_command_list)
}
(( $+functions[compdef] )) && compdef _gitignoreio gi

#--------------------------------------------------------------------------
# Key bindings
#--------------------------------------------------------------------------
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey -M vicmd 'k' history-substring-search-up
bindkey -M vicmd 'j' history-substring-search-down

#--------------------------------------------------------------------------
# Runtime managers
#--------------------------------------------------------------------------
# Omarchy standardises on mise, which zshrc.omarchy activates instead. Only
# wire up pyenv where nothing else is managing the runtime.
if ! dotfiles_platform_is omarchy; then
	if [ -d "$HOME/.pyenv" ]; then
		export PYENV_ROOT="$HOME/.pyenv"
		command -v pyenv >/dev/null || path_prepend "$PYENV_ROOT/bin"
		eval "$(pyenv init -)"
	fi
fi

# Rust
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

#--------------------------------------------------------------------------
# FZF
#--------------------------------------------------------------------------
if command -v fzf &>/dev/null; then
	if command -v fd &>/dev/null; then
		export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
		export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
		export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
	fi

	export FZF_DEFAULT_OPTS='
      --height 40%
      --layout=reverse
      --border=rounded
      --info=inline
      --bind="ctrl-/:toggle-preview"
    '

	if command -v bat &>/dev/null; then
		export FZF_CTRL_T_OPTS='--preview "bat --color=always --style=numbers --line-range=:50 {}" --preview-window=right:60%'
	else
		export FZF_CTRL_T_OPTS='--preview "cat {}" --preview-window=right:60%:wrap'
	fi

	export FZF_ALT_C_OPTS='--preview "ls -la --color {}"'
	export FZF_CTRL_R_OPTS='--sort --exact'

	[[ -f ~/.fzf.zsh ]] && source ~/.fzf.zsh
fi

# fzf-tab
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color $realpath'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'ls --color $realpath'
zstyle ':fzf-tab:*' switch-group ',' '.'

#--------------------------------------------------------------------------
# Prompt
#--------------------------------------------------------------------------
# Last, so starship wins over any prompt oh-my-zsh or the platform layer set.
command -v starship &>/dev/null && eval "$(starship init zsh)"
