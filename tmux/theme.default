# Nord Light Brighter, as hex. Hex values are used rather than the ANSI names
# so the status line stays put if the terminal palette is ever swapped.
#
# `install` links this file to ~/.tmux.theme.conf on machines where nothing
# else manages the palette. See theme.omarchy for the Omarchy variant.

setw -g clock-mode-colour '#1155a3'
setw -g mode-style 'fg=#24292e bg=#c2d9f5 bold'

# One flat divider. tmux paints the border segments touching the active pane
# with pane-active-border-style, which is what splits a single divider into two
# colours; matching the two styles makes it a solid line.
set -g pane-border-style 'fg=#d6d6d6'
set -g pane-active-border-style 'fg=#d6d6d6'

# Focus is shown by dimming the background of unfocused panes instead.
set -g window-style 'bg=#f6f8fa'
set -g window-active-style 'bg=#ffffff'

set -g status-position bottom
set -g status-justify left
set -g status-style 'fg=#474b4f bg=#ebebeb'

set -g status-left-style 'fg=#0d5c43 bold'
set -g status-left ' #h:#S '
set -g status-left-length 100

set -g status-right-style 'fg=#8995a0'
set -g status-right ' #{?mouse,#[fg=#50750e]M,#[fg=#f93232]M}#[fg=#8995a0] %Y-%m-%d %H:%M '
set -g status-right-length 50

setw -g window-status-current-style 'fg=#1155a3 bold'
setw -g window-status-current-format ' #I:#W '

setw -g window-status-style 'fg=#8995a0'
setw -g window-status-format ' #I:#W '

setw -g window-status-bell-style 'fg=#e36209 bold'

setw -g window-status-separator ""

set -g message-style 'fg=#ffffff bg=#e36209'
