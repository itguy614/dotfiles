# Smaller than the 16pt baseline in ghostty/config: this machine's display is
# a good deal tighter than the macOS monitors.
font-size = 10

# Omarchy owns the palette here: omarchy-theme-set rewrites the file below and
# every themed app follows it. Including it means the terminal keeps working
# with the theme switcher instead of being pinned to one scheme.
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# Carried over from Omarchy's packaged ghostty config -- these are fixes for
# the Hyprland session and for tmux key handling, not preferences.

# Fix general slowness on Hyprland
# https://github.com/ghostty-org/ghostty/discussions/3224
async-backend = epoll

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env

# Send Shift+Enter as CSI-u so TUIs can tell it apart from Enter, and
# Alt+Shift+Enter likewise so tmux can match M-S-Enter.
keybind = shift+enter=csi:13;2u
keybind = alt+shift+enter=csi:13;4u

keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Slow down mouse scrolling
mouse-scroll-multiplier = 0.95
