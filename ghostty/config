# Base Ghostty config, shared by every machine.
#
# Colours and platform-specific tweaks live in platform.conf, which `install`
# symlinks to the right ghostty/platform.<platform> variant. It is included
# last so the platform layer always wins.

font-family = "RobotoMono Nerd Font Mono"

# Baseline size, right for the big macOS displays. Platform files override it
# where the displays differ -- see ghostty/platform.omarchy. Keeping a value
# here rather than pushing it entirely into the platform layer means a machine
# with no platform.conf linked yet still starts at a sane size.
font-size = 16
adjust-cell-height = 50%
adjust-cursor-height = 110%

cursor-style = bar
cursor-style-blink = true

background-opacity = 1
window-height = 43
window-width = 132
window-padding-x = 4
window-padding-y = 2
window-decoration = auto
bold-is-bright = false

scrollback-limit = 10000

keybind = shift+enter=text:\x1b\r

# Remote hosts rarely ship the xterm-ghostty terminfo, and ssh refuses with
# "missing or unsuitable terminal". ssh-terminfo installs it on the host the
# first time we connect; ssh-env falls back to TERM=xterm-256color where that
# fails. Platform files that set this key must repeat both flags.
shell-integration-features = ssh-terminfo,ssh-env

config-file = ?"~/.config/ghostty/platform.conf"
